# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file - it's already in .gitignore.

# Your University of Toronto Quercus (Canvas) base URL. Leave as-is unless you
# use a different Canvas instance.
CANVAS_BASE_URL=https://q.utoronto.ca

# Canvas access token. See README.md "Getting a Canvas access token" for steps.
CANVAS_TOKEN=paste_your_canvas_token_here

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=paste_your_anthropic_key_here

# Optional overrides - uncomment to change defaults (see config.py)
# CLAUDE_MODEL=claude-opus-5  (default is claude-haiku-4-5, cheap/fast)
# ANNOUNCEMENT_LOOKBACK_DAYS=60
